#ChatDialog {
    background-color: #1e1e2f;
    color: #ffffff;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

#ProgramTitle {
    font-size: 24px;
    font-weight: bold;
    color: #f5f5f5;
    margin-bottom: 10px;
}

#ChatBox {
    background-color: #2a2a3d;
    border: 1px solid #444;
    padding: 8px;
    border-radius: 10px;
    min-height: 300px;
    color: #ffffff;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #444;
}

QListWidget::item:selected {
    background-color: #3a3a5a;
}

#UserInput {
    background-color: #2a2a3d;
    border: 1px solid #555;
    padding: 6px;
    border-radius: 8px;
    color: #fff;
}

QRadioButton {
    color: #ccc;
}

QRadioButton::indicator:checked {
    background-color: #4caf50;
    border: 1px solid #4caf50;
}

#SendButton, #SettingsButton {
    background-color: #4caf50;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
}

#SendButton:hover, #SettingsButton:hover {
    background-color: #45a049;
}

/* SETTINGS DIALOG STYLES */
QDialog {
    background-color: #1e1e2f;
    color: #ffffff;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

/* Make the scroll area background match your dialog */
QScrollArea {
    background-color: transparent; /* or #1e1e2f for full background */
    border: none;
}

/* This ensures the content inside QScrollArea doesn't show white */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Or this if the above doesn't catch the widget properly */
QAbstractScrollArea > QWidget {
    background-color: transparent;
}

/* Scrollbar styling for consistency */
QScrollBar:vertical {
    background: #2a2a3d;
    width: 8px;
    margin: 2px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #888;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #2a2a3d;
    height: 8px;
    margin: 0 2px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #888;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


QLabel {
    color: #dddddd;
    font-weight: normal;
}

QLineEdit {
    background-color: #2a2a3d;
    border: 1px solid #555;
    padding: 6px;
    border-radius: 6px;
    color: #ffffff;
}

QRadioButton {
    color: #cccccc;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #888;
    background-color: transparent;
}

QRadioButton::indicator:checked {
    background-color: #4caf50;
    border: 1px solid #4caf50;
    border-radius: 8px;
}

QPushButton {
    background-color: #4caf50;
    color: white;
    padding: 6px 12px;
    border: none;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #45a049;
}
